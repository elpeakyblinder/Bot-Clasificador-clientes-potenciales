---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../db';
import Header from '../components/Header.astro';
import KpiMetrics from '../components/KpiMetrics.astro';
import LeadsHistory from '../components/LeadsHistory.astro';
import type { Lead } from '../types';

let leads: Lead[] = [];
let dbError: string | null = null;

try {
  const sql = getDb();
  leads = await sql`
    SELECT id, created_at, raw_text, decision, reason, username 
    FROM leads 
    ORDER BY created_at DESC
  ` as Lead[];
} catch (err) {
  const error = err as Error;
  console.error("Error al consultar la base de datos Neon:", error);
  dbError = "No se pudo conectar a Neon Database. Por favor verifica DATABASE_URL.";
}

const totalLeads = leads.length;
const qualifiedLeads = leads.filter(l => l.decision === 'Cualificado').length;
const unqualifiedLeads = totalLeads - qualifiedLeads;
const conversionRate = totalLeads > 0 ? Math.round((qualifiedLeads / totalLeads) * 100) : 0;
---

<Layout>
  <main class="container">
    <Header />

    {dbError && (
      <div class="error-banner">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="error-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p>{dbError}</p>
      </div>
    )}

    <KpiMetrics 
      totalLeads={totalLeads} 
      qualifiedLeads={qualifiedLeads} 
      unqualifiedLeads={unqualifiedLeads} 
      conversionRate={conversionRate} 
    />

    <div class="workspace-full">
      <LeadsHistory leads={leads} />
    </div>
  </main>

  <style>
    .container {
      max-width: 1300px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .error-banner {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: rgba(239, 68, 68, 0.05);
      border: 1px solid rgba(239, 68, 68, 0.1);
      color: #f87171;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      font-size: 0.95rem;
    }

    .workspace-full {
      width: 100%;
    }
  </style>
</Layout>
